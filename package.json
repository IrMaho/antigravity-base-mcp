{
  "name": "base-mcp-server",
  "version": "1.0.0",
  "description": "Enterprise-grade Base MCP Server Template (Model Context Protocol Starter Kit) for creating custom AI agent tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server": "./bin/mcp-server.js",
    "mcp-cli": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "templates",
    "README.md",
    "GUIDE_FA.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "start": "node bin/mcp-server.js",
    "mcp": "node bin/mcp-server.js",
    "cli": "tsx bin/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stdio": "tsx scripts/test-stdio.ts",
    "test:all": "vitest run && tsx scripts/test-stdio.ts",
    "new-tool": "tsx scripts/create-tool.ts",
    "export-schemas": "tsx scripts/export-schemas.ts",
    "register": "tsx scripts/register-antigravity.ts",
    "register:antigravity": "tsx scripts/register-antigravity.ts",
    "setup": "npm install && npm run build && npm run register"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrMaho/antigravity-base-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "anthropic",
    "claude",
    "antigravity",
    "cursor",
    "tools",
    "json-rpc"
  ],
  "author": "Antigravity Engineering (IrMaho)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/IrMaho/antigravity-base-mcp/issues"
  },
  "homepage": "https://github.com/IrMaho/antigravity-base-mcp#readme",
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}